# FastAPI + React image (replaces Streamlit for the views already ported - currently "Mundo"
# and "Pantanal"; see CLAUDE.md). Single Cloud Run service: uvicorn serves both /api/* and the
# built React app (api/main.py mounts web/dist once it exists).
FROM node:22-slim AS web-build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM python:3.14-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8080 DATA_DIR=/app/data
WORKDIR /app
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt && useradd --create-home --uid 10001 app
RUN apt-get update && apt-get install -y --no-install-recommends libexpat1 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt requirements-maps.txt requirements-assistant.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-maps.txt -r requirements-assistant.txt
COPY --chown=app:app science.py weather.py ./
COPY --chown=app:app sarwatch ./sarwatch
COPY --chown=app:app api ./api
COPY --chown=app:app catalog ./catalog
COPY --chown=app:app --from=web-build /web/dist ./web/dist
RUN mkdir -p /app/data && chown app:app /app/data
USER 10001
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.getenv('PORT','8080')+'/api/health',timeout=3)"
CMD ["sh", "-c", "exec uvicorn api.main:app --host 0.0.0.0 --port $PORT"]
